    #     ^ variable
    #               ^ float
    float value05 = -5.
    # <- type.builtin
    #     ^ variable
    #               ^ float
    float value06 = 5.
    # <- type.builtin
    #     ^ variable
    #               ^ float
    float value07 = 5.1e+10
