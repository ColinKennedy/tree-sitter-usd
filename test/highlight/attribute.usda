    float value14 = -1e30
    # <- type.builtin
    #     ^ variable
    #               ^ float
}

def Shader "PbrPreview"
{
    float foo (doc="foo");
    # <- type.builtin
    #     ^ variable
    float bar = 1
    # <- type.builtin
    #     ^ variable
    #           ^ number

    float foo:bar:fizz:buzz = 1
    # <- type.builtin
    #     ^ namespace
    #        ^ punctuation.delimiter
    #         ^ namespace
    #            ^ punctuation.delimiter
    #             ^ namespace
    #                 ^ punctuation.delimiter
    #                  ^ variable
}
